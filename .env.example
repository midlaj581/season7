# Prefer DATABASE_URL on cloud providers (Railway/Render)
# Example: mysql://user:password@host:3306/dbname
DATABASE_URL=

# Fallback discrete DB vars (local/dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auction_system
DB_SSL=false
PORT=3000
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTO_BACKUP_INTERVAL_MS=30000
# Set true on production if you want startup to fail when DB is missing.
REQUIRE_DB=false
